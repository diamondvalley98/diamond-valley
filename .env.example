# Environment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — from Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# New Supabase dashboard label: "Publishable key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy alias (optional — either publishable or anon works)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional but recommended for server inserts (Settings → API → secret / service_role)
# Never expose this in the browser or commit it.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Resend — enquiry email notifications
RESEND_API_KEY=
# Must be a verified sender/domain in Resend, e.g. "Diamond Valley <hello@yourdomain.com>"
RESEND_FROM_EMAIL=
# Inbox that receives "New Website Enquiry" alerts
ENQUIRY_OWNER_EMAIL=
# Optional
# ENQUIRY_REPLY_TO=
# ENQUIRY_BRAND_NAME=Diamond Valley
# Set to false to disable customer acknowledgement emails
# ENQUIRY_ACK_EMAIL_ENABLED=true
